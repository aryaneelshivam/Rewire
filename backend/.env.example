# Copy to backend/.env. Without CLERK_PUBLISHABLE_KEY, sign-in is off and everything belongs to one local user.
# Only the publishable key is needed: tokens are checked against Clerk's public signing keys. No Clerk secret here.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Origins the frontend is served from (comma-separated). Tokens issued for other sites are refused.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
# Optional: analyses run at once (others wait their turn), and how many users' analyses stay in memory.
# REWIRE_MAX_JOBS=1
# REWIRE_MAX_OPEN=6
# Optional: key for signed video and image links. Generated into backend/data/.media_secret when unset.
# REWIRE_MEDIA_SECRET=
